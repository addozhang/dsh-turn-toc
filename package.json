{
  "name": "@addozhang/dsh-turn-toc",
  "version": "0.1.2",
  "description": "Turn section outline for the DeepSeek Harness Web GUI: frameless TurnNavigator-style tick marks beside the message column that expand on hover into an interactive multi-level heading outline with 1-click jump.",
  "author": "addozhang",
  "license": "MIT",
  "icon": "./icon.svg",
  "homepage": "https://github.com/addozhang/dsh-turn-toc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addozhang/dsh-turn-toc.git"
  },
  "bugs": {
    "url": "https://github.com/addozhang/dsh-turn-toc/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "toc",
    "outline",
    "navigation",
    "markdown"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/plugin-detail.zh.md",
    "docs/plugin-detail.en.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
